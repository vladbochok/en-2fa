# Ethereum mainnet JSON-RPC URL (for contract calls + sending tx)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# External Node Postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zksync_local

# Signer private key (0x...)
PK=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Polling interval
POLL_INTERVAL_SECS=3

# If set to 1, won’t send tx (prints what it would do)
DRY_RUN=0

# Chain address (diamond proxy)
CHAIN_ADDRESS=0x0000000000000000000000000000000000000000

# ExecutionMultisigValidator contract address
VALIDATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: enable Prometheus metrics and Kubernetes health endpoints on this port
# METRICS_PORT=8080
